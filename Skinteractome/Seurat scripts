library(SeuratDisk)
library(Seurat)

Convert("submission.h5ad", dest = "h5seurat", overwrite = TRUE)
skin <- LoadH5Seurat("submission.h5seurat")
eczema <- subset(x = skin, subset = (Status == "Eczema" & Site == "lesion"))

ad <- CreateSeuratObject(counts = eczema$RNA@counts, min.features = 200)


ad <- NormalizeData(object = ad)
ad <- FindVariableFeatures(object = ad)
ad <- ScaleData(object = ad)
ad <- RunPCA(object = ad)

ad <- FindNeighbors(object = ad)
ad <- FindClusters(object = ad, resolution = 0.1)
ad <- RunUMAP(object = ad, dim = 1:11)
DimPlot(object = ad, label = TRUE)

FeaturePlot(ad, features = 'OSM', cols = c('grey25', 'green'), pt.size = 1, order = TRUE)+DarkTheme()+NoAxes()

save(ad, file = "ad.RData")

ad_immune <- as.data.frame(GetAssayData(ad, slot = "counts")[, WhichCells(ad, ident = c("0","1"))])
adstromal <- subset(ad, idents = c("2","3","4","5","6"))

psoriasis <- subset(x = skin, subset = (Status == "Psoriasis" & Site == "lesion"))

psor <- CreateSeuratObject(counts = psoriasis$RNA@counts, min.features = 1000)


psor <- NormalizeData(object = psor)
psor <- FindVariableFeatures(object = psor)
psor <- ScaleData(object = psor)
psor <- RunPCA(object = psor)

psor <- FindNeighbors(object = psor)
psor <- FindClusters(object = psor, resolution = 0.1)
psor <- RunUMAP(object = psor, dim = 1:8)
DimPlot(object = psor, label = TRUE)


